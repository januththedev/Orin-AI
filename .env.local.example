# Copy to .env.local for a real-service development workspace.
# For a credential-free preview, use npm run dev:demo instead.
DATABASE_URL=
# Optional direct Neon connection for migrations; runtime keeps the pooled URL.
DATABASE_URL_UNPOOLED=
TOKEN_ENCRYPTION_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER_URL=
ORIN_AUTHORIZED_PARTIES=http://127.0.0.1:5173,http://localhost:5173
ORIN_ADMIN_PASSWORD=
ORIN_WORKER_SECRET=
# Add provider keys in Administration → Providers after entering the admin password at /admin.
# Full legacy and optional settings are documented in .env.example.
