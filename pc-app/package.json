{
  "name": "orin-ai-desktop",
  "version": "1.0.0",
  "description": "Orin AI Desktop App",
  "main": "main.js",
  "scripts": {
    "start":       "electron .",
    "build:win":   "electron-builder --win --x64",
    "build:mac":   "electron-builder --mac",
    "build:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "org.orinai.desktop",
    "productName": "Orin AI",
    "directories": { "output": "dist" },
    "files": ["main.js","preload.js","assets/**"],
    "extraResources": [{ "from": "assets/", "to": "assets/" }],
    "win":   { "target": [{"target":"nsis","arch":["x64"]}], "icon": "assets/icon.ico" },
    "mac":   { "target": "dmg", "icon": "assets/icon.icns" },
    "linux": { "target": "AppImage", "icon": "assets/icon.png" },
    "nsis":  { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^24.13.0"
  }
}
