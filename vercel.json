{
  "functions": {
    "api/auth/[...path].js": {
      "maxDuration": 30
    },
    "api/signin.js": {
      "maxDuration": 10
    },
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/me.js": {
      "maxDuration": 30
    },
    "api/admin.js": {
      "maxDuration": 60,
      "includeFiles": "public/student-knowledge/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/workspace",
      "destination": "/api/admin?workspace=1"
    },
    {
      "source": "/api/auth/session/:path*",
      "destination": "/api/auth/[...path]"
    },
    {
      "source": "/api/auth/mcp/:path*",
      "destination": "/api/auth/[...path]"
    },
    {
      "source": "/api/auth/router/:path*",
      "destination": "/api/auth/[...path]"
    },
    {
      "source": "/api/auth/account/:path*",
      "destination": "/api/auth/[...path]"
    },
    {
      "source": "/januth-nimnal",
      "destination": "/januth-nimnal.html"
    },
    {
      "source": "/((?!api/|student-knowledge/|sitemap.xml|robots.txt|favicon.svg|favicon.ico|favicon-32.png|apple-touch-icon.png|mask-icon.svg|sw.js|manifest.json|assets|refresh\\.html|privacy\\.html|releases\\.html|januth-nimnal\\.html|google[0-9a-f]+\\.html|og-.*\\.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/refresh.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    }
  ]
}
