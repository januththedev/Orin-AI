# ─────────────────────────────────────────────────────────────────────────────
# Orin AI — environment template.
# Copy to .env.local for local dev. In production set these in Vercel → Settings → Environment Variables.
# NEVER commit .env / .env.local.
#
# Auth + data are 100% Neon + this backend. There is NO Firebase, NO Clerk,
# NO third-party auth SDK: password accounts (scrypt in Neon), Google sign-in
# (GIS button → verified with Google → Orin session), Neon Auth JWTs
# (Ed25519/JWKS verify). Sessions are HS256 JWTs signed below.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres (server-side, REQUIRED for auth + all app data).
# Neon Console → your project → Connection Details → pooled connection string.
# Then run api/_lib/schema.sql once in the Neon SQL editor.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Session signing key — REQUIRED, minimum 32 characters. Signs Orin session
# tokens (HS256) AND encrypts OAuth tokens at rest. Rotating it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# AI providers — server-side only. Numbered OpenRouter pool (FREE models only):
# add/rotate keys by redeploying envs, no code changes. Legacy OPENROUTER_API_KEY
# still accepted as fallback. Create keys at openrouter.ai (no card needed).
OPENROUTER_1=
OPENROUTER_2=
OPENROUTER_3=
OPENROUTER_4=
OPENROUTER_5=
OPENROUTER_6=
GEMINI_API_KEY=          # OPTIONAL — sandbox tools + modalities ONLY (video / TTS /
                         # embeddings / computer-use / code-exec). ALL text AI is
                         # OpenRouter; Gemini is never used for chat (API_KEY legacy alias accepted).
# Image generation uses Pollinations.ai — completely free, NO key, no config.

# Groq — web search for freshness-intent chat (groq/compound-mini, built-in
# search, generous free tier). Without it, search falls back to the OpenRouter
# web plugin ($4/1k results on your OpenRouter keys). Free key: console.groq.com.
GROQ_API_KEY=
# Voice (read-aloud): Fish Audio S2.1 Pro Free via OpenRouter (83 languages,
# free). Override only if you know a better OpenRouter TTS id.
# TTS_MODEL=fish-audio/s2.1-pro-free:free

# Telegram — TWO bots, two tokens (one from @BotFather per bot):
# Orin AI = chat bot (balanced chain) · Orin Code = PC remote system
# (pairing, approvals, run-on-PC tasks + coding answers).
# Webhook per bot (secret_token optional but recommended):
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook?url=https://orinai.org/api/telegram&secret_token=<TELEGRAM_WEBHOOK_SECRET>
# https://api.telegram.org/bot<TELEGRAM_CODE_BOT_TOKEN>/setWebhook?url=https://orinai.org/api/telegram-code&secret_token=<TELEGRAM_CODE_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CODE_BOT_TOKEN=
TELEGRAM_CODE_WEBHOOK_SECRET=

# PC ↔ phone link (Orin Code bot approvals on your phone). Long random value,
# server-only — the bot and pc-link endpoints share it internally.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PC_LINK_SECRET=

# Optional signup bypass code for role escalation via admin portal (never hardcode in source)
ORIN_SECRET_CODE=

# Google sign-in button (web) + Gmail/Drive/etc. integrations:
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web):
# authorized origin https://orinai.org (+ www + localhost for dev), redirect
# https://orinai.org/auth/google/callback. Paste the SAME client ID in both lines.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# Server secret for the SAME OAuth client (exchange/refresh of module tokens).
GOOGLE_CLIENT_SECRET=

# Server override for the Neon Auth JWKS (default is this project's endpoint).
# Only needed if you sign users in through Neon Auth hosted UI directly.
# NEON_AUTH_JWKS_URL=https://ep-dawn-butterfly-avsgxtbo.neonauth.c-11.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# reCAPTCHA (optional)
VITE_RECAPTCHA_SITE_KEY=
