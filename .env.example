# ─────────────────────────────────────────────────────────────────────────────
# Orin AI — environment template.
# Copy to .env.local for local dev. In production set these in Vercel → Settings → Environment Variables.
# NEVER commit .env / .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Admin (server-side, REQUIRED for api/* functions).
# Firebase Console → Project Settings → Service Accounts → Generate new private key,
# then paste the whole JSON as a single string (or use Vercel's multiline support).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Token encryption key — REQUIRED, minimum 32 characters. Encrypts OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# AI providers — server-side only. Numbered OpenRouter pool (FREE models only):
# add/rotate keys by redeploying envs, no code changes. Legacy OPENROUTER_API_KEY
# still accepted as fallback. Create keys at openrouter.ai (no card needed).
OPENROUTER_1=
OPENROUTER_2=
OPENROUTER_3=
OPENROUTER_4=
OPENROUTER_5=
OPENROUTER_6=
GEMINI_API_KEY=          # OPTIONAL — only needed for video / TTS / embeddings /
                         # research / code-exec modes (API_KEY legacy alias accepted).
# Image generation uses Pollinations.ai — completely free, NO key, no config.

# Telegram bot (no sign-in; DMs + @mentions in groups reply via the same pool).
# Set webhook once: https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook?url=https://orinai.org/api/telegram&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=


# Orin AI router instance (OmniRoute, separate deployment). When ROUTER_BASE_URL is set,
# ALL chat/agent text traffic is proxied through it (token/model analytics in its dashboard),
# with direct OpenRouter as automatic failover.
ROUTER_BASE_URL=
ROUTER_API_KEY=

# Stripe — REMOVED: Orin AI is completely free (checkout/webhook endpoints deleted).
# You can delete these vars from Vercel too.

# Daily maintenance cron (/api/maintenance) — Vercel sends this as Bearer auth
CRON_SECRET=

# Optional signup bypass code for role escalation via admin portal (never hardcode in source)
ORIN_SECRET_CODE=

# File storage — legacy deletions only (file library retired; chat attachments are inline)
# BLOB_READ_WRITE_TOKEN=

# Google OAuth integration (Gmail etc.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Spotify integration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Web Push (Firebase Cloud Messaging)
VAPID_KEY=

# reCAPTCHA (optional)
VITE_RECAPTCHA_SITE_KEY=

# Firebase web config (public identifiers — injected into the client bundle)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
