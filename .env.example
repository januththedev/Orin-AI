# ─────────────────────────────────────────────────────────────────────────────
# Orin AI — environment template.
# Copy to .env.local for local dev. In production set these in Vercel → Settings → Environment Variables.
# NEVER commit .env / .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Admin (server-side, REQUIRED for api/* functions).
# Firebase Console → Project Settings → Service Accounts → Generate new private key,
# then paste the whole JSON as a single string (or use Vercel's multiline support).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Token encryption key — REQUIRED, minimum 32 characters. Encrypts OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# AI providers — server-side only. Numbered OpenRouter pool (FREE models only):
# add/rotate keys by redeploying envs, no code changes. Legacy OPENROUTER_API_KEY
# still accepted as fallback. Create keys at openrouter.ai (no card needed).
OPENROUTER_1=
OPENROUTER_2=
OPENROUTER_3=
OPENROUTER_4=
OPENROUTER_5=
OPENROUTER_6=
GEMINI_API_KEY=          # OPTIONAL — sandbox tools + modalities ONLY (video / TTS /
                         # embeddings / computer-use / code-exec). ALL text AI is
                         # OpenRouter; Gemini is never used for chat (API_KEY legacy alias accepted).
# Image generation uses Pollinations.ai — completely free, NO key, no config.

# Telegram — TWO bots, two tokens (one from @BotFather per bot):
# Orin AI = chat bot (balanced chain) · Orin Code = PC remote system
# (pairing, approvals, run-on-PC tasks + coding answers).
# Webhook per bot (secret_token optional but recommended):
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook?url=https://orinai.org/api/telegram&secret_token=<TELEGRAM_WEBHOOK_SECRET>
# https://api.telegram.org/bot<TELEGRAM_CODE_BOT_TOKEN>/setWebhook?url=https://orinai.org/api/telegram-code&secret_token=<TELEGRAM_CODE_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CODE_BOT_TOKEN=
TELEGRAM_CODE_WEBHOOK_SECRET=

# PC ↔ phone link (Orin Code bot approvals on your phone). Long random value,
# server-only — the bot and pc-link endpoints share it internally.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PC_LINK_SECRET=

# Optional signup bypass code for role escalation via admin portal (never hardcode in source)
ORIN_SECRET_CODE=

# Google OAuth integration (Gmail etc.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Web Push (Firebase Cloud Messaging)
VAPID_KEY=

# reCAPTCHA (optional)
VITE_RECAPTCHA_SITE_KEY=

# Firebase web config (public identifiers — injected into the client bundle).
# Firebase Console → Project Settings → General → Your apps → SDK setup.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Google Sign-In setup (all in Firebase Console — no code changes needed):
# 1. Authentication → Sign-in method → enable Google (pick a support email).
# 2. Authentication → Settings → Authorized domains → ADD: orinai.org,
#    www.orinai.org, localhost, plus every Vercel preview domain you use.
# 3. Project Settings → Service Accounts → Generate new private key →
#    paste the whole JSON as FIREBASE_SERVICE_ACCOUNT (server, fixes 500s).
