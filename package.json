{
  "name": "orin-ai-workspace",
  "private": true,
  "version": "4.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "platform:build": "npm --prefix vendor/orin-platform ci && npm --prefix vendor/orin-platform run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run platform:build && vitest run --maxWorkers=1",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.3.2",
    "jose": "6.2.12",
    "jstat": "1.9.6",
    "katex": "0.16.38",
    "mathjs": "15.2.0",
    "nerdamer": "1.1.13",
    "pdf-parse": "1.1.4",
    "plotly.js-dist-min": "3.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "17.0.0",
    "@orin/contracts": "file:vendor/orin-platform/packages/contracts",
    "@orin/client": "file:vendor/orin-platform/packages/client",
    "@orin/config": "file:vendor/orin-platform/packages/config",
    "@orin/security": "file:vendor/orin-platform/packages/security",
    "@orin/observability": "file:vendor/orin-platform/packages/observability",
    "@orin/ui": "file:vendor/orin-platform/packages/ui"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/node": "22.19.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.4.19",
    "babel-plugin-react-compiler": "1.0.0",
    "oxc-transform-react": "0.145.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "author": {
    "name": "Januth Nimnal",
    "email": "nimnaljanuth@gmail.com"
  }
}
