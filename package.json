{
  "name": "orin-ai-workspace",
  "private": true,
  "version": "4.2.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-workspace.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "platform:build": "npm --prefix vendor/orin-platform ci && npm --prefix vendor/orin-platform run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run platform:build && vitest run --maxWorkers=1",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test",
    "dev:api": "node --env-file-if-exists=.env.local scripts/dev-api.mjs",
    "dev:demo:api": "node scripts/dev-api.mjs --demo",
    "dev:demo": "node scripts/dev-workspace.mjs --demo",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-workspace.mjs",
    "history:import": "node --env-file-if-exists=.env.local scripts/import-workspace-history.mjs",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "test:integration": "vitest run tests/integration",
    "verify:landing": "node scripts/verify-landing.mjs",
    "verify:admin": "node scripts/verify-admin.mjs",
    "knowledge:build": "node scripts/build-student-knowledge.mjs",
    "knowledge:import": "node --env-file-if-exists=.env.local scripts/import-student-knowledge.mjs",
    "prebuild": "npm run knowledge:build",
    "verify:students": "node scripts/verify-student-library.mjs"
  },
  "dependencies": {
    "@clerk/react": "6.18.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sinhala": "5.3.0",
    "@fontsource-variable/noto-sans-tamil": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@neondatabase/serverless": "1.1.0",
    "@orin/client": "file:vendor/orin-platform/packages/client",
    "@orin/config": "file:vendor/orin-platform/packages/config",
    "@orin/contracts": "file:vendor/orin-platform/packages/contracts",
    "@orin/observability": "file:vendor/orin-platform/packages/observability",
    "@orin/security": "file:vendor/orin-platform/packages/security",
    "@orin/ui": "file:vendor/orin-platform/packages/ui",
    "@vercel/blob": "2.3.2",
    "jose": "6.2.12",
    "jstat": "1.9.6",
    "katex": "0.16.38",
    "lucide-react": "1.61.0",
    "mathjs": "15.2.0",
    "nerdamer": "1.1.13",
    "pdf-parse": "1.1.4",
    "plotly.js-dist-min": "3.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "stripe": "17.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/node": "22.19.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.4.19",
    "babel-plugin-react-compiler": "1.0.0",
    "oxc-transform-react": "0.145.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "author": {
    "name": "Januth Nimnal",
    "email": "nimnaljanuth@gmail.com"
  }
}
